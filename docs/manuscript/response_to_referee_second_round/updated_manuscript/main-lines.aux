\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Parameters, their physical meaning, and the injected values used to generate synthetic data. The injected values are listed for validating the ANC scheme in Section \ref  {sec:results}, and quantifying the performance of the scheme as a function of the properties of the mains power interference in Section \ref  {sec:theroccurves}. $a_r$ and $a_c$ are randomly drawn from separate uniform distributions, denoted by $\mathcal  {U}$. The braces notation (e.g. $\{0.01, 0.1\}$) indicates that multiple injected values are trialled. The quoted injected values of the three amplitude parameters and the four noise parameters are scaled such that $\sigma _n^2 = 1$.}}{10}{table.1}\protected@file@percent }
\newlabel{tab:parameterdescription1}{{I}{10}{Parameters, their physical meaning, and the injected values used to generate synthetic data. The injected values are listed for validating the ANC scheme in Section \ref {sec:results}, and quantifying the performance of the scheme as a function of the properties of the mains power interference in Section \ref {sec:theroccurves}. $a_r$ and $a_c$ are randomly drawn from separate uniform distributions, denoted by $\mathcal {U}$. The braces notation (e.g. $\{0.01, 0.1\}$) indicates that multiple injected values are trialled. The quoted injected values of the three amplitude parameters and the four noise parameters are scaled such that $\sigma _n^2 = 1$}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  HMM tracking of a CW signal with spin wandering in the presence of $60 \, {\rm  Hz}$ mains power interference before (left panel) and after (right panel) ANC. Coloured contours (arbitrary units; see colour bar at right) show the spectrogram of the data, i.e.\ the squared modulus of the Fourier transform of $x(t)$. The $60 \, {\rm  Hz}$ line is visible as a vertical yellow band in the left panel; it cannot be discerned in the right panel. Injected signals: lower spin wandering, with $\sigma _f (N \Delta t)^{1/2} / f_{\rm  ac} = 0.047$ and $ h_0 \sqrt  {T_{\rm  obs}} / \sigma _n = 0.71$ (solid orange curve); higher spin wandering, with $\sigma _f (N \Delta t)^{1/2} / f_{\rm  ac} = 0.15$ and $ h_0 \sqrt  {T_{\rm  obs}} / \sigma _n = 0.71$ (solid green curve). Recovered signals: dashed white curves. Neither signal can be detected before ANC, so the dashed white curves are visible in the right panel only.}}{10}{figure.7}\protected@file@percent }
\newlabel{frequency tracking before and after1}{{7}{10}{HMM tracking of a CW signal with spin wandering in the presence of $60 \, {\rm Hz}$ mains power interference before (left panel) and after (right panel) ANC. Coloured contours (arbitrary units; see colour bar at right) show the spectrogram of the data, i.e.\ the squared modulus of the Fourier transform of $x(t)$. The $60 \, {\rm Hz}$ line is visible as a vertical yellow band in the left panel; it cannot be discerned in the right panel. Injected signals: lower spin wandering, with $\sigma _f (N \Delta t)^{1/2} / f_{\rm ac} = 0.047$ and $ h_0 \sqrt {T_{\rm obs}} / \sigma _n = 0.71$ (solid orange curve); higher spin wandering, with $\sigma _f (N \Delta t)^{1/2} / f_{\rm ac} = 0.15$ and $ h_0 \sqrt {T_{\rm obs}} / \sigma _n = 0.71$ (solid green curve). Recovered signals: dashed white curves. Neither signal can be detected before ANC, so the dashed white curves are visible in the right panel only}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A}Mains power interference parameters}{10}{section*.15}\protected@file@percent }
\newlabel{sec:roc1}{{V\,A}{10}{}{section*.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Detection probability $p_{\rm  d}$ as a function of false alarm probability $p_{\rm  fa}$ (i.e. ROC curve) for HMM tracking of a CW signal ($ h_0 \sqrt  {T_{\rm  obs}} / \sigma _n = 0.62$) in conjunction with the ANC scheme, for different mains power interference parameters. The top, middle and bottom panels display different values of $\Delta f_{\rm  ac}$, $\sigma _{\Theta }^2$, and $P$ respectively. The grey dashed curve in all panels corresponds to the performance of a random classifier. The grey dotted curve in all panels is a performance upper limit, corresponding to the case where there is zero mains power interference. In all panels the curves overlap approximately, illustrating that the performance of the HMM and ANC scheme is insensitive to the mains power parameters. At $p_{\rm  fa} = 0.05$, the mean $p_{\rm  d}$ across the three curves is 0.52 (top panel), 0.48 (middle panel) and 0.58 (bottom panel).}}{11}{figure.8}\protected@file@percent }
\newlabel{fig:roc1}{{8}{11}{Detection probability $p_{\rm d}$ as a function of false alarm probability $p_{\rm fa}$ (i.e. ROC curve) for HMM tracking of a CW signal ($ h_0 \sqrt {T_{\rm obs}} / \sigma _n = 0.62$) in conjunction with the ANC scheme, for different mains power interference parameters. The top, middle and bottom panels display different values of $\Delta f_{\rm ac}$, $\sigma _{\Theta }^2$, and $P$ respectively. The grey dashed curve in all panels corresponds to the performance of a random classifier. The grey dotted curve in all panels is a performance upper limit, corresponding to the case where there is zero mains power interference. In all panels the curves overlap approximately, illustrating that the performance of the HMM and ANC scheme is insensitive to the mains power parameters. At $p_{\rm fa} = 0.05$, the mean $p_{\rm d}$ across the three curves is 0.52 (top panel), 0.48 (middle panel) and 0.58 (bottom panel)}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Same as Figure \ref  {fig:roc1} but for different ANC filter parameters. The top, middle and bottom panels display the ROC curves for different numbers of PEM reference channels $N_{\rm  ref}$, tap weights $M$, and forgetting factors $\lambda $ respectively. All panels additionally include the ROC curve for a random classifier (i.e. the lower performance limit, grey dashed curve) and the zero interference ROC curve (i.e. the upper performance limit, grey dotted curve).}}{11}{figure.9}\protected@file@percent }
\newlabel{fig:roc2}{{9}{11}{Same as Figure \ref {fig:roc1} but for different ANC filter parameters. The top, middle and bottom panels display the ROC curves for different numbers of PEM reference channels $N_{\rm ref}$, tap weights $M$, and forgetting factors $\lambda $ respectively. All panels additionally include the ROC curve for a random classifier (i.e. the lower performance limit, grey dashed curve) and the zero interference ROC curve (i.e. the upper performance limit, grey dotted curve)}{figure.9}{}}
